<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yin.yin.mapper.SettingMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.yin.yin.model.Setting">
        <id column="id" property="id" />
        <result column="type" property="type" />
        <result column="setting_key" property="settingKey" />
        <result column="setting_value" property="settingValue" />
        <result column="description" property="description" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 根据类型查询设置列表 -->
    <select id="selectByType" resultMap="BaseResultMap">
        SELECT * FROM t_setting WHERE type = #{type}
    </select>

    <!-- 根据类型和键查询设置 -->
    <select id="selectByTypeAndKey" resultMap="BaseResultMap">
        SELECT * FROM t_setting WHERE type = #{type} AND setting_key = #{key}
    </select>

    <!-- 插入设置 -->
    <insert id="insert" parameterType="com.yin.yin.model.Setting">
        INSERT INTO t_setting (
            type, setting_key, setting_value, description, create_time, update_time
        ) VALUES (
            #{type}, #{settingKey}, #{settingValue}, #{description}, NOW(), NOW()
        )
    </insert>

    <!-- 更新设置 -->
    <update id="update" parameterType="com.yin.yin.model.Setting">
        UPDATE t_setting
        <set>
            <if test="settingValue != null">setting_value = #{settingValue},</if>
            <if test="description != null">description = #{description},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除设置 -->
    <delete id="deleteById">
        DELETE FROM t_setting WHERE id = #{id}
    </delete>
</mapper>
