<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yin.yin.mapper.RoleMapper">

    <resultMap id="BaseResultMap" type="com.yin.yin.model.Role">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="code" property="code" />
        <result column="status" property="status" />
        <result column="description" property="description" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, name, code, status, description, create_time, update_time
    </sql>

    <!-- 根据ID查询角色 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM role
        WHERE id = #{id}
    </select>

    <!-- 查询所有角色 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM role
        ORDER BY id ASC
    </select>

    <!-- 根据用户ID查询角色列表 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT r.*
        FROM role r
        INNER JOIN user_role ur ON r.id = ur.role_id
        WHERE ur.user_id = #{userId}
        ORDER BY r.id ASC
    </select>

    <!-- 插入角色 -->
    <insert id="insert" parameterType="com.yin.yin.model.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO role (
            name, code, status, description, create_time, update_time
        ) VALUES (
            #{name}, #{code}, #{status}, #{description}, #{createTime}, #{updateTime}
        )
    </insert>

    <!-- 更新角色 -->
    <update id="update" parameterType="com.yin.yin.model.Role">
        UPDATE role
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="code != null">code = #{code},</if>
            <if test="status != null">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updateTime != null">update_time = #{updateTime}</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除角色 -->
    <delete id="deleteById">
        DELETE FROM role WHERE id = #{id}
    </delete>

</mapper>
